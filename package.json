{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern apps/api/dist --ignore-pattern apps/api/.test-dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @aims/api",
    "test": "npm test --workspace @aims/api",
    "test:storage": "npm run test:storage --workspace @aims/api",
    "test:ai:live": "npm run test:ai:live --workspace @aims/api",
    "test:ai:financial-live": "npm run test:ai:financial-live --workspace @aims/api",
    "test:ai:finance-intelligence-live": "npm run test:ai:finance-intelligence-live --workspace @aims/api",
    "test:dashboard:integration": "npm run test:dashboard:integration --workspace @aims/api",
    "test:policy:integration": "npm run test:policy:integration --workspace @aims/api",
    "test:approval:integration": "npm run test:approval:integration --workspace @aims/api",
    "test:finance-control:integration": "npm run test:finance-control:integration --workspace @aims/api",
    "test:payment:integration": "npm run test:payment:integration --workspace @aims/api",
    "test:uat:integration": "npm run test:uat:integration --workspace @aims/api",
    "test:telegram:live": "npm run test:telegram:live --workspace @aims/api"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@cloudflare/workers-types": "5.20260826.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.126.0"
  },
  "type": "module"
}
