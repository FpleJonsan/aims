{
  "name": "@aims/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && node --env-file=../../.env --watch dist/src/main.js",
    "start": "node --env-file=../../.env dist/src/main.js",
    "worker": "node --env-file=../../.env dist/src/worker-main.js",
    "dev:worker": "npm run build && node --env-file=../../.env dist/src/worker-main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/alert-specification.test.js .test-dist/test/observability.test.js .test-dist/test/ai-governance.test.js .test-dist/test/local-storage.test.js .test-dist/test/document-security-migration.test.js .test-dist/test/payment-slip-trust-transition-migration.test.js .test-dist/test/document-worker-migration.test.js .test-dist/test/payment-request-domain.test.js .test-dist/test/validation-contract.test.js .test-dist/test/finance-context.test.js .test-dist/test/financial-analysis.test.js .test-dist/test/finance-intelligence.test.js .test-dist/test/policy.test.js .test-dist/test/approval.test.js .test-dist/test/finance-control.test.js .test-dist/test/production-config.test.js .test-dist/test/worker-config.test.js .test-dist/test/auth-session.test.js .test-dist/test/health.test.js .test-dist/test/payment-export.test.js .test-dist/test/approval-pagination.test.js .test-dist/test/payment-queue.test.js .test-dist/test/portal-boundary.test.js",
    "test:p11": "tsc -p tsconfig.test.json && node --test .test-dist/test/alert-specification.test.js",
    "test:approval:integration": "node scripts/run-isolated-integration.mjs .test-dist/test/approval-integration.test.js",
    "test:finance-control:integration": "node scripts/run-isolated-integration.mjs .test-dist/test/finance-control-integration.test.js",
    "test:payment:integration": "node scripts/run-isolated-integration.mjs .test-dist/test/finance-control-integration.test.js",
    "test:telegram:live": "tsc -p tsconfig.test.json && node --env-file=../../.env .test-dist/test/telegram-live-smoke.js",
    "test:ai:live": "tsc -p tsconfig.test.json && node --env-file=../../.env .test-dist/test/live-ai-smoke.js",
    "test:ai:financial-live": "tsc -p tsconfig.test.json && node --env-file=../../.env .test-dist/test/financial-ai-live-smoke.js",
    "test:ai:finance-intelligence-live": "tsc -p tsconfig.test.json && node --env-file=../../.env .test-dist/test/finance-intelligence-live-smoke.js",
    "test:dashboard:integration": "node scripts/run-isolated-integration.mjs .test-dist/test/dashboard-integration.test.js",
    "test:integration": "node scripts/run-isolated-integration.mjs .test-dist/test/postgres-integration.test.js",
    "test:validation:integration": "node scripts/run-isolated-integration.mjs .test-dist/test/validation-integration.test.js",
    "test:finance-context:integration": "node scripts/run-isolated-integration.mjs .test-dist/test/finance-context-integration.test.js",
    "test:financial-analysis:integration": "node scripts/run-isolated-integration.mjs .test-dist/test/financial-analysis-integration.test.js",
    "test:policy:integration": "node scripts/run-isolated-integration.mjs .test-dist/test/policy-integration.test.js",
    "test:storage": "tsc -p tsconfig.test.json && node --test .test-dist/test/local-storage.test.js",
    "test:document-security:integration": "node scripts/run-isolated-integration.mjs .test-dist/test/document-security-integration.test.js",
    "test:worker:integration": "node scripts/run-isolated-integration.mjs .test-dist/test/document-worker-integration.test.js",
    "test:p10:integration": "node scripts/run-isolated-integration.mjs .test-dist/test/observability-integration.test.js",
    "test:uat:integration": "node scripts/run-isolated-integration.mjs .test-dist/test/day10-uat-integration.test.js",
    "test:integration-isolation": "node --test scripts/integration-database-guard.test.mjs",
    "reset:competition": "node --env-file=../../.env scripts/competition-reset.mjs",
    "seed:competition": "npm run build && node --env-file=../../.env scripts/competition-seed.mjs",
    "verify:competition-data": "node --env-file=../../.env scripts/competition-verify.mjs",
    "dev:competition": "npm run build && node --env-file=../../.env scripts/competition-api.mjs",
    "test:p6:database-proof": "node scripts/p6-disposable-proof.mjs"
  },
  "type": "module",
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1"
  }
}
