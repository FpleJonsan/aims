{
  "name": "@aims/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build && node --env-file=../../.env --watch dist/src/main.js",
    "start": "node --env-file=../../.env dist/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/test/local-storage.test.js .test-dist/test/payment-request-domain.test.js .test-dist/test/validation-contract.test.js .test-dist/test/finance-context.test.js .test-dist/test/financial-analysis.test.js .test-dist/test/finance-intelligence.test.js .test-dist/test/policy.test.js .test-dist/test/approval.test.js .test-dist/test/finance-control.test.js .test-dist/test/production-config.test.js .test-dist/test/health.test.js .test-dist/test/payment-export.test.js .test-dist/test/approval-pagination.test.js .test-dist/test/payment-queue.test.js .test-dist/test/portal-boundary.test.js",
    "test:approval:integration": "tsc -p tsconfig.test.json && node --env-file=../../.env --test .test-dist/test/approval-integration.test.js",
    "test:finance-control:integration": "tsc -p tsconfig.test.json && node --env-file=../../.env --test .test-dist/test/finance-control-integration.test.js",
    "test:payment:integration": "tsc -p tsconfig.test.json && node --env-file=../../.env --test .test-dist/test/finance-control-integration.test.js",
    "test:telegram:live": "tsc -p tsconfig.test.json && node --env-file=../../.env .test-dist/test/telegram-live-smoke.js",
    "test:ai:live": "tsc -p tsconfig.test.json && node --env-file=../../.env .test-dist/test/live-ai-smoke.js",
    "test:ai:financial-live": "tsc -p tsconfig.test.json && node --env-file=../../.env .test-dist/test/financial-ai-live-smoke.js",
    "test:ai:finance-intelligence-live": "tsc -p tsconfig.test.json && node --env-file=../../.env .test-dist/test/finance-intelligence-live-smoke.js",
    "test:dashboard:integration": "tsc -p tsconfig.test.json && node --env-file=../../.env --test .test-dist/test/dashboard-integration.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node --env-file=../../.env --test .test-dist/test/postgres-integration.test.js",
    "test:validation:integration": "tsc -p tsconfig.test.json && node --env-file=../../.env --test .test-dist/test/validation-integration.test.js",
    "test:finance-context:integration": "tsc -p tsconfig.test.json && node --env-file=../../.env --test .test-dist/test/finance-context-integration.test.js",
    "test:financial-analysis:integration": "tsc -p tsconfig.test.json && node --env-file=../../.env --test .test-dist/test/financial-analysis-integration.test.js",
    "test:policy:integration": "tsc -p tsconfig.test.json && node --env-file=../../.env --test .test-dist/test/policy-integration.test.js",
    "test:storage": "tsc -p tsconfig.test.json && node --test .test-dist/test/local-storage.test.js",
    "test:uat:integration": "tsc -p tsconfig.test.json && node --env-file=../../.env --test .test-dist/test/day10-uat-integration.test.js"
  },
  "type": "module",
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/pg": "^8.23.1"
  }
}
