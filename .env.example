# Copy this file to .env for local development.
# Never commit real passwords, tokens, or other secrets.

# Existing local Redis container (my-redis-container).
# Database 15 keeps AIMS development keys separate from its existing keys.
REDIS_URL=redis://localhost:6379/15

# Restricted application role created with docs/LOCAL-DEVELOPMENT.md. Hosted
# environments inject these server-only values at runtime; never expose them as
# frontend build arguments.
DATABASE_URL=postgresql://aims_app:replace_with_a_local_password@localhost:5432/aims
# Separate server-only credential. This login must be a member of the NOLOGIN
# aims_finance_executor role and must never be exposed to clients or SQL users.
FINANCE_DATABASE_URL=postgresql://aims_finance_runtime:replace_with_a_different_local_password@localhost:5432/aims
# Separate server-only Payment capability; never expose this credential to SQL users.
PAYMENT_DATABASE_URL=postgresql://aims_payment_runtime:replace_with_another_local_password@localhost:5432/aims
# Hosted Production must set an explicit isolated database identity. All three
# URLs must target it with distinct users and sslmode=verify-full.
AIMS_EXPECTED_DATABASE=
BUSINESS_TIMEZONE=Asia/Kuala_Lumpur
API_PORT=3001
API_HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
# Provider-independent local session foundation. The browser receives an opaque
# HttpOnly cookie; Finance authority continues to come from PostgreSQL.
LOCAL_SESSION_LIFETIME_SECONDS=28800
# Keep false for local HTTP. HTTPS environments must set this true.
LOCAL_COOKIE_SECURE=false

# Optional Day 2 Document Agent. Keep AI_MASTER disabled in the database for manual-only mode.
# Provider credentials are server-only runtime injection values. Empty means disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Day 9 AI limits are enforced server-side; database AI_MASTER/FINANCE_WATCH/
# ASK_AIMS switches remain authoritative. Pricing is intentionally unconfigured.
FINANCE_WATCH_MAX_DEPARTMENTS=20
FINANCE_WATCH_MAX_CATEGORIES=20
FINANCE_WATCH_MAX_VENDORS=20
ASK_AIMS_MAX_ROWS=20
MAX_PAYMENT_EXPORT_ROWS=10000

# Optional compatibility values for LOCAL PostgreSQL Docker administration only.
# AIMS application runtime does not read these. Never configure them in hosted
# application runtime or reuse them as application credentials.
POSTGRES_DB=aims
POSTGRES_USER=replace_with_container_admin_user
POSTGRES_PASSWORD=replace_with_container_admin_password

# Explicit environment selection for the isolated competition dataset. Keep
# `development` for normal local work. Competition commands require the exact
# database name `aims_competition` and refuse to operate when NODE_ENV=production.
AIMS_ENVIRONMENT=development
# Deprecated compatibility alias. Prefer AIMS_ENVIRONMENT=competition.
AIMS_DEMO_MODE=false
COMPETITION_DATABASE_NAME=aims_competition

# Store uploaded documents on this machine during development.
# Production will replace this adapter with Amazon S3.
STORAGE_DRIVER=local
LOCAL_STORAGE_DEMO_MODE=true
LOCAL_STORAGE_PATH=./storage/documents
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png
# Deterministic lifecycle adapter for LOCAL development/tests only. Production
# must use an approved provider adapter and will reject this value.
MALWARE_SCANNER_DRIVER=deterministic-local
# Optional Day 6 Telegram approval channel (server-side only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CALLBACK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_TEST_CHAT_ID=
# Temporary PROCESSING claims older than this are eligible for safe recovery.
OUTBOX_PROCESSING_LEASE_SECONDS=120
