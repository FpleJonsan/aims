# Copy this file to .env for local development.
# Never commit real passwords, tokens, or other secrets.

# Existing local Redis container (my-redis-container).
# Database 15 keeps AIMS development keys separate from its existing keys.
REDIS_URL=redis://localhost:6379/15

# Restricted application role created with docs/LOCAL-DEVELOPMENT.md.
DATABASE_URL=postgresql://aims_app:replace_with_a_local_password@localhost:5432/aims

# Store uploaded documents on this machine during development.
# Production will replace this adapter with Amazon S3.
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage/documents
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png
